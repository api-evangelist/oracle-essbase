{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/FileList",
  "title": "FileList",
  "type": "object",
  "description": "File catalog listing response.",
  "properties": {
    "currentFolder": {
      "$ref": "#/components/schemas/FileItem"
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/components/schemas/FileItem"
      }
    },
    "totalResults": {
      "type": "integer",
      "format": "int64"
    },
    "count": {
      "type": "integer",
      "format": "int64"
    },
    "limit": {
      "type": "integer",
      "format": "int64"
    },
    "offset": {
      "type": "integer",
      "format": "int64"
    },
    "hasMore": {
      "type": "boolean"
    }
  }
}