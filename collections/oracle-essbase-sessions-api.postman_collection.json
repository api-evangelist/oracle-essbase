          "name": "Oracle Essbase List Sessions",
          "request": {
            "name": "Oracle Essbase List Sessions",
            "description": {
              "content": "Returns a list of currently active sessions. Optionally filter by application, database, or user ID. If userId is not provided, all sessions are retrieved.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "sessions"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "application",
                  "value": "<string>",
                  "description": "Filter by application name."
                },
                {
                  "disabled": false,
                  "key": "database",
                  "value": "<string>",
                  "description": "Filter by database name."
                },
                {
                  "disabled": false,
                  "key": "userId",
                  "value": "<string>",
                  "description": "Filter by user ID. If not provided, returns all sessions."
                }
              ],
              "variable": [
                {
                  "description": "Essbase server hostname",
                  "type": "any",
                  "value": "{{host}}",
                  "key": "host"
                },
                {
                  "description": "Essbase server port",
                  "type": "any",
                  "value": "{{port}}",
                  "key": "port"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
