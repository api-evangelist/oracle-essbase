  "auth": {
    "type": "basic",
    "basic": [
      {
        "key": "username",
        "value": "{{basicAuthUsername}}",
        "type": "string"
      },
      {
        "key": "password",
        "value": "{{basicAuthPassword}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "host",
      "value": "localhost"
    },
    {
      "key": "port",
      "value": "9001"
    },
    {
      "key": "baseUrl",
      "value": "https://{{host}}:{{port}}/essbase/rest/v1"
    }
  ]
}